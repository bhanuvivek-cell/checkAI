# Assumption Check AI Root Environment Configuration

# Backend Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OpenAI API Key (Optional)
# If left blank, the platform automatically runs in clearly labeled Demo/Analytical Heuristics Mode.
# To enable live LLM reasoning, add your key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./assumption_check.db

# Optional Evidence Search Key (Tavily, Serper, etc.)
SEARCH_API_KEY=
