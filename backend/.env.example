# Assumption Check AI Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OpenAI API Configuration (Optional: if empty, app runs in clearly labeled Demo/Analytical Mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternative model examples: gpt-4o, gpt-3.5-turbo

# Database Configuration (SQLite default; PostgreSQL ready e.g. postgresql+asyncpg://user:pass@localhost:5432/checkai)
DATABASE_URL=sqlite+aiosqlite:///./assumption_check.db

# Evidence Search API Configuration (Optional: DuckDuckGo / Tavily / Serper)
# Leave empty to use built-in verifiable search & analytical verification heuristics
SEARCH_API_KEY=
